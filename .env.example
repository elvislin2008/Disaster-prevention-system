# ==============================================================================
# 清水國小校園災難與演練即時點名通報系統 V20.4 — 環境變數範本 (.env.example)
# ==============================================================================
# 部署至 Vercel 或本機執行時，請複製本檔為 .env 並填入實際雲端專案憑證。

# ------------------------------------------------------------------------------
# 1. Firebase Web Client 設定 (Firestore 即時資料層與離線快取)
# ------------------------------------------------------------------------------
# 可由 Firebase Console ➔ 專案設定 ➔ 一般 ➔ 您的應用程式 ➔ SDK 設定取得
FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890abcdef
FIREBASE_AUTH_DOMAIN=qingshui-disaster.firebaseapp.com
FIREBASE_PROJECT_ID=qingshui-disaster
FIREBASE_STORAGE_BUCKET=qingshui-disaster.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# 前端 Bundler (如 Vite / Webpack) 相容前綴
VITE_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=qingshui-disaster.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qingshui-disaster
VITE_FIREBASE_STORAGE_BUCKET=qingshui-disaster.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ------------------------------------------------------------------------------
# 2. Supabase Auth 設定 (教職員與指揮官帳號、Session 與身分權限管理 - R6)
# ------------------------------------------------------------------------------
# 可由 Supabase Dashboard ➔ Project Settings ➔ API 取得
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exampleAnonKey1234567890
# 前端 Bundler 相容前綴
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exampleAnonKey1234567890
# 服務端管理員金鑰 (選用，僅用於後端腳本批次管理使用者)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exampleServiceRoleKey

# ------------------------------------------------------------------------------
# 3. Firebase Admin 憑證 (供 scripts/seed-firestore.mjs 資料庫批次匯入腳本使用)
# ------------------------------------------------------------------------------
# 可填寫 Service Account JSON 檔案路徑，或直接將 JSON 字串貼於此
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# 4. 系統演練預設設定
# ------------------------------------------------------------------------------
# 演練授權快速解鎖密碼 (預設: 8888)
DRILL_DEFAULT_PASSWORD=8888
# 上午時段邊界 (12:40 對應之絕對分鐘數: 760)
SCHEDULE_CUTOFF_MINUTES_AM=760
